﻿@{
	var username = User.Claims.FirstOrDefault(c => c.Type == "unique_name")?.Value ?? "User";
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - PresentationLayer</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/PresentationLayer.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

</head>

<body>
	<header>
		<nav class="navbar navbar-expand-lg navbar-light custom-navbar mb-4">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Transaction" asp-action="Create">
					<i class="fa-solid fa-mug-saucer"></i> Caffein
				</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
						aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="" asp-controller="Transaction" asp-action="Create">Order</a>
						</li>

						@if (User.IsInRole("Admin"))
						{
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle fw-bold" href="#" id="managementDropdown"
								   role="button" data-bs-toggle="dropdown" aria-expanded="false">
									<i class="fa fa-cogs"></i> Management
								</a>
								<ul class="dropdown-menu" aria-labelledby="managementDropdown">
									<li class="nav-item">
										<a class="dropdown-item" asp-area="" asp-controller="Transaction" asp-action="Index">
											<i class="fa-solid fa-table"></i> Transactions
										</a>
									</li>
									<li class="nav-item">
										<a class="dropdown-item" asp-area="" asp-controller="Table" asp-action="Index">
											<i class="fa-solid fa-table"></i> Tables
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Users" asp-action="Index">
											<i class="fa fa-users"></i> User
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Beverage" asp-action="Index">
											<i class="fa fa-box"></i> Beverage
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Vouchers" asp-action="Index">
											<i class="fa fa-box"></i> Voucher
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Revenue" asp-action="Index">
											<i class="fa fa-chart-line"></i> Revenue
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Shift" asp-action="ShiftCalendar">
											<i class="fa fa-calendar"></i> Shifts Calendar
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Shift" asp-action="ApproveRequests">
											<i class="fa-solid fa-table"></i> Approve Requests
										</a>
									</li>
								</ul>
							</li>
						}
						else if (User.IsInRole("Staff"))
						{
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle fw-bold" href="#" id="staffManagementDropdown"
								   role="button" data-bs-toggle="dropdown" aria-expanded="false">
									<i class="fa fa-briefcase"></i> Staff
								</a>
								<ul class="dropdown-menu" aria-labelledby="staffManagementDropdown">
									<li class="nav-item">
										<a class="dropdown-item" asp-area="" asp-controller="Transaction" asp-action="Index">
											<i class="fa-solid fa-table"></i> Transactions
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Salary" asp-action="Index">
											<i class="fa-solid fa-money-bill"></i> Salary
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Shift" asp-action="RequestShift">
											<i class="fa fa-tasks "></i> Request Shifts
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="Shift" asp-action="MyRequests">
											<i class="fa fa-list "></i> My Requests
										</a>
									</li>
								</ul>
							</li>
						}
					</ul>

					<ul class="navbar-nav">
						@if (User.Identity?.IsAuthenticated == true)
						{

							<li class="nav-item d-flex align-items-center me-3">
								<a asp-controller="Users" asp-action="Profile">
									<span class="navbar-text fw-bold">
										<i class="fa fa-user"></i> Hello @username
									</span>
								</a>
							</li>
							<li class="nav-item">
								<form method="post" asp-action="Logout" asp-controller="Auth">
									<button type="submit" class="btn btn-link text-danger">
										<i class="fa fa-sign-out-alt"></i> Logout
									</button>
								</form>
							</li>
						}
						else
						{
							<li class="nav-item">
								<a class="nav-link text-dark" asp-area="" asp-controller="Auth" asp-action="Login">
									<i class="fa fa-sign-in-alt"></i> Login
								</a>
							</li>
						}
					</ul>
				</div>
			</div>
		</nav>

	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-dark custom-footer mt-5">
		<div class="container d-flex justify-content-between align-items-center flex-wrap">
			<span>Rise and grind, it's coffee time!</span>
			<span>
				<a class="text-decoration-none text-muted me-3" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
				<a class="text-decoration-none text-muted me-3" asp-area="" asp-controller="Contact" asp-action="Index">Contact</a>
				<a href="#" class="text-muted"><i class="fab fa-facebook"></i></a>
				<a href="#" class="text-muted mx-2"><i class="fab fa-twitter"></i></a>
				<a href="#" class="text-muted"><i class="fab fa-linkedin"></i></a>
			</span>
		</div>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

	<script>
		$(document).ready(function () {
			var message = '@TempData["SuccessMessage"]';
			if (message) {
				toastr.success(message);
			}

			var error = '@TempData["ErrorMessage"]';
			if (error) {
				toastr.error(error);
			}
		});
	</script>
	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>