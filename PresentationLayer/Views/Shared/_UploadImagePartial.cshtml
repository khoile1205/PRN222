@using Shared.Constants

@{
    bool isAvatar = ViewData["Path"].Equals(CloudinaryPathName.USER);
}
<div id="upload-container">
    <div class="d-flex align-items-center">
        <div class="form-group flex-grow-1">
            <input type="file" name="file" id="fileInput" class="form-control" accept="image/*">
        </div>
        <span id="loadingSpinner" class="spinner-border spinner-border-sm ms-2" role="status" style="display: none;"></span>
    </div>
    <div id="uploadResult" style="margin-top: 10px;">
        @if (ViewData["ImageUrl"] != null)
        {
            @if (isAvatar)
            {
                <img src="@(ViewData["ImageUrl"] ?? "/images/default_avatar.png")" alt="Uploaded Avatar" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover; display: block; margin-top: 10px;" />
            }
            else
            {

                <img src="@ViewData["ImageUrl"].ToString()" alt="Uploaded Image" style="max-width: 200px; display: block; margin-top: 10px;" />
            }
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        $("#fileInput").change(function (event) {
            event.preventDefault();

            var fileInput = this;
            if (!fileInput.files || fileInput.files.length === 0) {
                return;
            }

            $("#fileInput").prop("disabled", true);
            $("#loadingSpinner").show();

            var formData = new FormData();
            formData.append("file", fileInput.files[0]);
            var uploadPath = @Html.Raw(Json.Serialize(ViewData["Path"]?.ToString() ?? CloudinaryPathName.MAIN_FOLDER.ToString()));
            formData.append("path", @Html.Raw(Json.Serialize(ViewData["Path"]?.ToString() ?? CloudinaryPathName.MAIN_FOLDER.ToString())));
            
            $.ajax({
                url: "/Upload/UploadImage",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response && response.success) {
                        var isAvatar = uploadPath === "@CloudinaryPathName.USER.ToString()";
                        var $form = $("form");
                        var $imageUrlField;
                        if (isAvatar) {
                            $imageUrlField = $form.find("input[name='Avatar']");
                        } else {
                            $imageUrlField = $form.find("input[name='ImageUrl']")
                        }
                        var $previewContainer = $form.find("#currentImage");

                        if ($imageUrlField.length) {
                            $imageUrlField.val(response.imageUrl);
                        } else {
                            console.warn("ImageUrl input not found in the form.");
                        }
                        if (isAvatar) {
                            // Avatar-specific rendering
                            $("#uploadResult").html(
                                `<img src="${response.imageUrl}" alt="Uploaded Avatar" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover; display: block; margin-top: 10px;">`
                            );
                        } else if ($previewContainer.length) {
                            // Existing preview container behavior
                            $previewContainer.html(
                                `<img src="${response.imageUrl}" alt="New Beverage Image" style="max-width: 200px;" />`
                            );
                        } else {
                            // Default rendering
                            $("#uploadResult").html(
                                `<img src="${response.imageUrl}" alt="Uploaded Image" style="max-width: 200px; display: block; margin-top: 10px;">`
                            );
                        }
                        toastr.success("Image uploaded successfully!");

                    } else {
                        toastr.error(response.message || "Upload failed.");
                    }
                },
                error: function (xhr, status, error) {
                    var errorMessage = xhr.responseJSON?.message || "An error occurred while uploading the image.";
                    toastr.error(errorMessage);
                },
                complete: function () {
                    $("#fileInput").prop("disabled", false);
                    $("#loadingSpinner").hide();
                }
            });
        });

    });
</script>