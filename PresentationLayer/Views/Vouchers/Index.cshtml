@model IEnumerable<DataLayer.Entities.Voucher>

@{
    ViewData["Title"] = "Vouchers";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Voucher List</h2>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fa fa-plus"></i> Create New Voucher
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>Code</th>
                            <th>Percentage</th>
                            <th>Description</th>
                            <th>Max Discount Amount</th>
                            <th>Amount</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Created At</th>
                            <th>Updated At</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.Percentage</td>
                                <td>@item.Description</td>
                                <td>@item.MaxDiscountAmount</td>
                                <td>@item.Amount</td>
                                <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>@item.UpdatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">
                                            <i class="fa fa-eye"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted text-right">
            Total vouchers: @Model.Count()
        </div>
    </div>
</div>
