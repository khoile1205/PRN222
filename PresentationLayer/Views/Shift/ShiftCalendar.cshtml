@model List<PresentationLayer.ViewModel.ShiftCalendarViewModel>

@{
    ViewData["Title"] = "Shift Calendar";
    var staffCountPerDate = Model.ToDictionary(
    day => day.Date.ToString("yyyy-MM-dd"),
    day => day.Registrations.Select(x => x.StaffName).Distinct().Count()
    );
}

<h2>Shift Registration Calendar (All Approved Shifts)</h2>
<div id="calendar" class="mb-5"></div>

<!-- Styles -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />

<!-- Modal for daily shift list -->
<div class="modal fade" id="shiftListModal" tabindex="-1" aria-labelledby="shiftListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shiftListModalLabel">Shifts On Selected Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="shiftListModalBody">
                <!-- Table will be inserted here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar with global support -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script>
        const staffCounts = @Html.Raw(Json.Serialize(staffCountPerDate));
        let calendar;

        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');

            if (calendar) 
            {
                calendar.destroy();
            }
            calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                themeSystem: 'bootstrap5',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,listWeek'
                },
                eventContent: function (arg) {
                    return {
                        html: `
                            <div class="custom-list-event">
                                <strong>${arg.event.extendedProps.staffName}</strong><br>
                                ${arg.view.type == 'dayGridMonth' ? `<span>${arg.event.extendedProps.shiftTime}</span><br>` : ''}
                            </div>
                        `
                    };
                },
                events: [
                    @foreach (var day in Model)
                    {
                        foreach (var reg in day.Registrations)
                        {
                            <text>
                                {
                                    title: '@reg.StaffName',
                                    start: '@reg.ShiftStartTime.ToString("yyyy-MM-ddTHH:mm:ss")',
                                    end: '@reg.ShiftEndTime.ToString("yyyy-MM-ddTHH:mm:ss")',
                                    allDay: false,
                                    display: 'block',
                                    extendedProps: {
                                        staffName: '@reg.StaffName',
                                        shiftDescription: '@reg.ShiftDescription',
                                        shiftTime: '@reg.ShiftStartTime.ToString("HH:mm:ss") - @reg.ShiftEndTime.ToString("HH:mm:ss")',
                                        date: '@day.Date.ToString("yyyy-MM-dd")'
                                    }
                                },
                            </text>
                        }
                    }
                ],
                eventClick: function (info) {
                    if (info.view.type != 'listWeek') {
                        const clickedDate = info.event.extendedProps.date;
                        showShiftListModal(clickedDate);
                    }
                },

                dateClick: function (info) {
                    showShiftListModal(info.dateStr);
                }
            });

            function showShiftListModal(date) {
                let dayEvents = calendar.getEvents().filter(e =>
                    e.startStr.startsWith(date) && e.extendedProps.staffName
                );

                // Sort by shift start time
                dayEvents = dayEvents.sort((a, b) => {
                    const timeA = a.extendedProps.shiftTime.split(' - ')[0];
                    const timeB = b.extendedProps.shiftTime.split(' - ')[0];
                    return timeA.localeCompare(timeB);
                });

                if (dayEvents.length > 0) {
                    let tableHtml = `
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Staff Name</th>
                                    <th>Shift Description</th>
                                    <th>Shift Time</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                    `;
                    dayEvents.forEach(ev => {
                        tableHtml += `
                            <tr>
                                <td>${ev.extendedProps.staffName}</td>
                                <td>${ev.extendedProps.shiftDescription}</td>
                                <td>${ev.extendedProps.shiftTime}</td>
                                <td>${date}</td>
                            </tr>
                        `;
                    });
                    tableHtml += `</tbody></table>`;

                    document.getElementById('shiftListModalBody').innerHTML = tableHtml;
                    new bootstrap.Modal(document.getElementById('shiftListModal')).show();
                }
            }
            calendar.render();
        });
    </script>
}
