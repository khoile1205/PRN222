@model DataLayer.Entities.ShiftStaff

@{
    ViewData["Title"] = "Request Shift";
}

<h2>Request a Shift</h2>

<form asp-action="RequestShift" method="post">
    <div class="mb-3">
        <label for="ShiftDate" class="form-label">Shift Date:</label>
        <input type="date" asp-for="ShiftDate" class="form-control" required />
    </div>

    <div class="mb-3">
        <label for="ShiftId" class="form-label">Select Shift:</label>
        <select asp-for="ShiftId" class="form-control" asp-items="ViewBag.ShiftId"></select>
    </div>

    <button type="submit" class="btn btn-primary">Request</button>
</form>
