@using System.Globalization
@using DataLayer.Enums
@model DataLayer.Entities.PaginationResult<DataLayer.Entities.ShiftStaff>

@{
    ViewData["Title"] = "My Shift Requests";
}

<h2>My Shift Requests</h2>

<form method="get" class="d-flex gap-2 align-items-center">
    <select name="month" class="form-select form-select-sm" style="width: 120px;" onchange="this.form.submit()">
        <option value="">All Months</option>
        @for (int i = 1; i <= 12; i++)
        {
            <option value="@i" selected="@(i.ToString() == Context.Request.Query["month"])">@DateTimeFormatInfo.CurrentInfo.GetMonthName(i)</option>
        }
    </select>
    <select name="year" class="form-select form-select-sm" style="width: 100px;" onchange="this.form.submit()">
        <option value="">All Years</option>
        @for (int i = DateTime.Now.Year - 5; i <= DateTime.Now.Year + 1; i++)
        {
            <option value="@i" selected="@(i.ToString() == Context.Request.Query["year"])">@i</option>
        }
    </select>
</form>

<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th class="ps-4">Shift Date</th>
                <th>Shift Type</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Data.Any())
            {
                <tr>
                    <td colspan="3" class="text-center py-4 text-muted">
                        No shift requests found
                    </td>
                </tr>
            }
            else
            {
                @foreach (var request in Model.Data)
                {
                    <tr>
                        <td class="ps-4">@request.ShiftDate.ToString("MMM dd, yyyy")</td>
                        <td>@request.Shift.ShiftCode <span class="text-muted">(@request.Shift.StartTime) - (@request.Shift.EndTime)</span> </td>
                        <td>
                            <span class="badge @GetStatusClass(request.Status)">
                                @request.Status
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_PaginationPartial" />

@functions {
    private string GetStatusClass(RequestStatus status)
    {
        switch (status)
        {
            case RequestStatus.Accepted:
                return "bg-success text-white";
            case RequestStatus.Pending:
                return "bg-warning";
            case RequestStatus.Rejected:
            default:
                return "bg-secondary text-white";
        };
    }
}
