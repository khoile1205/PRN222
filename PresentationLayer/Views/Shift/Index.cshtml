@model IEnumerable<DataLayer.Entities.Shift>

@{
    ViewData["Title"] = "Shifts";
}

<h2>Shifts</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Shift Code</th>
            <th>Description</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var shift in Model)
        {
            <tr>
                <td>@shift.ShiftCode</td>
                <td>@shift.Description</td>
                <td>@shift.StartTime</td>
                <td>@shift.EndTime</td>
                <td>@shift.ShiftType</td>
            </tr>
        }
    </tbody>
</table>
