@model PresentationLayer.Models.BeverageViewModel

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input asp-for="SizeId" class="form-control" hidden />
    </div>

    <div class="form-group">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- Hidden input to store the Cloudinary ImageUrl -->
    <input type="hidden" asp-for="ImageUrl" id="imageUrl" />

    <!-- Display current image if it exists -->
    <div class="form-group">
        <label class="form-label">Current Image</label>
        <div id="currentImage">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Current Beverage Image" style="max-width: 200px;" />
            }
            else
            {
                <p>No image available</p>
            }
        </div>
    </div>
     <div class="form-group">
        <label>Upload Image</label>
        <partial name="_UploadImagePartial" />
    </div>
    @* <div class="form-group">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div> *@

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
