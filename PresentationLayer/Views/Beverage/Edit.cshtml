<form asp-action="Edit" method="post">
    <input type="hidden" id="Id" name="Id" value="@Model.Id" />

    <div class="form-group">
        <label for="Name">Name</label>
        <input type="text" id="Name" name="Name" value="@Model.Name" class="form-control" />
    </div>

    <div class="form-group">
        <label for="SizeId">Size</label>
        <input type="text" id="SizeId" name="SizeId" value="@Model.SizeId" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Price">Price</label>
        <input type="number" id="Price" name="Price" value="@Model.Price" class="form-control" step="0.01" />
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea id="Description" name="Description" class="form-control">@Model.Description</textarea>
    </div>

    <div class="form-group">
        <label for="ImageUrl">Image URL</label>
        <input type="text" id="ImageUrl" name="ImageUrl" value="@Model.ImageUrl" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
