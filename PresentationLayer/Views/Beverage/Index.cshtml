@model IEnumerable<PresentationLayer.Models.BeverageViewModel>
@{
    ViewData["Title"] = "Beverages";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">Beverage List</h2>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fa fa-plus"></i> Add New Beverage
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Sizes & Prices</th>
                            <th>Description</th>
                            <th>Image</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var beverage in Model)
                        {
                            <tr>
                                <td>@beverage.Name</td>
                                <td>@beverage.CategoryName</td>
                                <td>
                                    @if (beverage.Details.Any())
                                    {
                                        <ul>
                                            @foreach (var detail in beverage.Details)
                                            {
                                                <li>@detail.SizeName - @detail.Price.ToString("C")</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span>No sizes available</span>
                                    }
                                </td>
                                <td>@beverage.Description</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(beverage.ImageUrl))
                                    {
                                        <img src="@beverage.ImageUrl" alt="@beverage.Name" width="50" />
                                    }
                                    else
                                    {
                                        <span>No Image</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@beverage.Id" class="btn btn-warning btn-sm me-2">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>
                                        <form asp-action="DeleteConfirmed" asp-route-id="@beverage.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this beverage?');">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted text-right">
            Total beverages: @Model.Count()
        </div>
    </div>
</div>
