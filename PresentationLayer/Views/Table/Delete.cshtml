@model DataLayer.Entities.Table

@{
    ViewData["Title"] = "Delete Table";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Table</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TableName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TableName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SeatQuantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SeatQuantity)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Area)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Area)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="fa fa-trash"></i> Delete
        </button>
        <a asp-action="Index" class="btn btn-warning">
            <i class="fa fa-arrow-left"></i> Back
        </a>
    </form>

</div>
