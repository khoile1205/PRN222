@model DataLayer.Entities.Table

@{
    ViewData["Title"] = "Table Details";
}

<div class="card shadow-lg p-4">
    <h2 class="text-center">
        <i class="fa fa-info-circle"></i> Table Details
    </h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-4">Table Name:</dt>
        <dd class="col-sm-8">@Model.TableName</dd>

        <dt class="col-sm-4">Seat Quantity:</dt>
        <dd class="col-sm-8">@Model.SeatQuantity</dd>

        <dt class="col-sm-4">Area:</dt>
        <dd class="col-sm-8">@Model.Area</dd>

        <dt class="col-sm-4">Updated At:</dt>
        <dd class="col-sm-8">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>

        <dt class="col-sm-4">Deleted At:</dt>
        <dd class="col-sm-8">
            @(Model.DeletedAt.HasValue ? Model.DeletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")
        </dd>
    </dl>

    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fa fa-edit"></i> Edit
        </a>

        <a asp-action="Index" class="btn btn-warning">
            <i class="fa fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>
