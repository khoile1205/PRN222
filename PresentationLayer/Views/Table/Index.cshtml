@model IEnumerable<DataLayer.Entities.Table>

@{
    ViewData["Title"] = "Table List";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">
                <i class="fa fa-table"></i> Table List
            </h2>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fa fa-plus"></i> Create New Table
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.TableName)</th>
                            <th>@Html.DisplayNameFor(model => model.SeatQuantity)</th>
                            <th>@Html.DisplayNameFor(model => model.Area)</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.DeletedAt != null ? "text-muted" : "")">
                                <td>@Html.DisplayFor(modelItem => item.TableName)</td>
                                <td>@Html.DisplayFor(modelItem => item.SeatQuantity)</td>
                                <td>@Html.DisplayFor(modelItem => item.Area)</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        @if (item.DeletedAt == null)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-2">
                                                Edit
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-2">
                                                Details
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                                Delete
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-action="Restore" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    Restore
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted text-right">
            Total tables: @Model.Count()
        </div>
    </div>
</div>
