@model DataLayer.Entities.Table

@{
    ViewData["Title"] = "Create Table";
}

<div class="card shadow-lg p-4">
    <h2 class="text-center">
        <i class="fa fa-table"></i> Create New Table
    </h2>
    <hr />

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6">
                <h5 class="text-secondary"><i class="fa fa-info-circle"></i> Table Information</h5>
                <div class="form-group">
                    <label asp-for="TableName" class="form-label fw-bold"></label>
                    <input asp-for="TableName" class="form-control" />
                    <span asp-validation-for="TableName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SeatQuantity" class="form-label fw-bold"></label>
                    <input asp-for="SeatQuantity" type="number" class="form-control" min="1" />
                    <span asp-validation-for="SeatQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <h5 class="text-secondary"><i class="fa fa-map-marker"></i> Table Location</h5>

                <div class="form-group">
                    <label asp-for="Area" class="form-label fw-bold"></label>
                    <select asp-for="Area" class="form-control" asp-items="ViewBag.AreaList"></select>
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="form-label fw-bold"></label>
                    <select asp-for="Status" class="form-control" asp-items="ViewBag.StatusList"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success mt-3">
                    <i class="fa fa-plus"></i> Create
                </button>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-warning">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
