@model IEnumerable<DataLayer.Entities.Transaction>

<h1 class="fw-bold">
    <i class="bi bi-receipt"></i> Transactions
</h1>

<form method="get" asp-action="Index" class="mb-3 mt-3 d-flex">
    <label for="startDate" class="form-label me-2 mt-2">Start Date:</label>
    <input type="date" id="startDate" name="startDate" class="form-control w-auto me-3" value="@ViewBag.StartDate">

    <label for="endDate" class="form-label me-2 mt-2">End Date:</label>
    <input type="date" id="endDate" name="endDate" class="form-control w-auto me-3" value="@ViewBag.EndDate">

    <button type="submit" class="btn btn-success">
        <i class="bi bi-search"></i>
    </button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Table</th>
            <th>Beverage</th>
            <th>Price</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TableDetail.Table.TableName</td>
                <td>
                    @string.Join(", ", item.TableDetail.TableBeverages
                             .Where(tb => tb.BeverageDetail?.Size != null)
                             .Select(tb => $"{tb.BeverageDetail.Beverage.Name} ({tb.BeverageDetail.Size.SizeName})"))

                </td>
                <td>@item.Price VND</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<nav aria-label="Page navigation">
    <ul class="pagination">
        @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
        {
            <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, page = i })">@i</a>
            </li>
        }
    </ul>
</nav>


<a asp-action="Create" class="btn btn-warning">
    <i class="fa fa-arrow-left"></i> Back To Order
</a>