@model IEnumerable<DataLayer.Entities.User>

@{
    ViewData["Title"] = "User List";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">
                <i class="fa fa-users"></i> Users List
            </h2>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fa fa-plus"></i> Create New
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Position)</th>
                            <th>@Html.DisplayNameFor(model => model.Role)</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.Position)</td>
                                <td>@Html.DisplayFor(modelItem => item.Role.RoleName)</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-2">
                                            <i class="fa fa-edit"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-2">
                                            <i class="fa fa-eye"></i> Details
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-2">
                                            <i class="fa fa-key"></i> Reset Password
                                        </a>
                                        @if (item.DeletedAt == null)
                                        {
                                            <form asp-action="DeleteUser" method="post" style="display:inline;">
                                                <input type="hidden" name="userId" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fa fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="RestoreUser" method="post" style="display:inline;">
                                                <input type="hidden" name="userId" value="@item.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="fa fa-undo"></i> Restore
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted text-right">
            Total users: @Model.Count()
        </div>
    </div>
</div>
