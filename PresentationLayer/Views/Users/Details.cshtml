@model DataLayer.Entities.User

@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2 class="mb-0">User Details</h2>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <tr>
                    <th style="width: 30%;">User Name</th>
                    <td>@Html.DisplayFor(model => model.UserName)</td>
                </tr>
                <tr>
                    <th>Phone Number</th>
                    <td>@Html.DisplayFor(model => model.PhoneNumber)</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>@Html.DisplayFor(model => model.Email)</td>
                </tr>
                <tr>
                    <th>Avatar</th>
                    <td>@Html.DisplayFor(model => model.Avatar)</td>
                </tr>
                <tr>
                    <th>Name</th>
                    <td>@Html.DisplayFor(model => model.Name)</td>
                </tr>
                <tr>
                    <th>Date Of Birth</th>
                    <td>@Html.DisplayFor(model => model.DateOfBirth)</td>
                </tr>
                <tr>
                    <th>Gender</th>
                    <td>@Html.DisplayFor(model => model.Gender)</td>
                </tr>
                <tr>
                    <th>Position</th>
                    <td>@Html.DisplayFor(model => model.Position)</td>
                </tr>
                <tr>
                    <th>Start Date</th>
                    <td>@Html.DisplayFor(model => model.StartDate)</td>
                </tr>
                <tr>
                    <th>Role</th>
                    <td>@Html.DisplayFor(model => model.Role.RoleName)</td>
                </tr>
                <tr>
                    <th>Created At</th>
                    <td>@Html.DisplayFor(model => model.CreatedAt)</td>
                </tr>
                <tr>
                    <th>Updated At</th>
                    <td>@Html.DisplayFor(model => model.UpdatedAt)</td>
                </tr>
            </table>
        </div>
        <div class="card-footer text-center">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info">
                <i class="fa fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary ml-2">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
